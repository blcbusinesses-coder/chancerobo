# ============================================================
#  C.H.A.N.C.E ECOSYSTEM — ENVIRONMENT TEMPLATE
#  Copy this file to `.env` and fill in real values.
#  NEVER commit the real .env file.
# ============================================================

# --- Anthropic (Tri-Tier Model Routing) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional model overrides (defaults are set in src/core/ModelRouter.ts)
MODEL_BIG=claude-opus-4-8
MODEL_MEDIUM=claude-sonnet-5
MODEL_SMALL=claude-haiku-4-5-20251001

# --- Supabase (Dedicated Tables + RLS) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key = master access. Used ONLY by CHANCE (the Overseer).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Anon key = per-agent scoped access (RLS enforced).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- ElevenLabs (Outgoing Voice) ---
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID_CHANCE=21m00Tcm4TlvDq8ikWAM

# --- OpenAI Whisper (Incoming Speech-to-Text) [optional] ---
# Leave blank to use a self-hosted / local Whisper endpoint instead.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Telegram (Per-Agent Bot) ---
# Each agent gets its own token. CHANCE's token below.
TELEGRAM_BOT_TOKEN_CHANCE=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Public base URL for webhooks (e.g. from ngrok / your host). Optional; polling used if unset.
TELEGRAM_WEBHOOK_BASE_URL=
# Restrict who can command the bot (your Telegram user id). Strongly recommended once computer-control tools are on.
TELEGRAM_OWNER_ID=

# --- Google (Workspace + Cloud APIs: Gmail, Calendar, Drive, YouTube) ---
# There is no single "master" Google key. You use ONE OAuth client (or a service
# account) + the googleapis library to reach every Google service.
#
# PATH A — OAuth 2.0 client (acts AS the agent's own Google account: send Gmail,
#   manage Calendar/Drive, upload YouTube). From Google Cloud Console ->
#   APIs & Services -> Credentials -> Create OAuth client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth2/callback
# Filled in automatically after the one-time consent flow (npm run google:auth):
GOOGLE_REFRESH_TOKEN=
#
# PATH B — Service Account JSON (server-to-server; Workspace domain-wide delegation).
#   Download the key file from Cloud Console and drop it in ./secrets/ (gitignored),
#   then point this at it. THIS IS THE "upload the google cloud credentials" slot.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json
# Comma-separated scopes the agent should request (sensible default set below).
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/drive,https://www.googleapis.com/auth/youtube

# --- Runtime ---
NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# --- Fire TV (ADB control) ---
# TV IP (enable ADB debugging on the Fire TV first). adb.exe path optional (bundled default used).
FIRETV_IP=
ADB_PATH=

# --- Voice ---
# TTS_PROVIDER: edge (free MS neural, no key) or elevenlabs. TTS_VOICE: e.g. en-GB-RyanNeural, en-US-ChristopherNeural
TTS_PROVIDER=edge
TTS_VOICE=en-GB-RyanNeural

# --- Kling AI ---
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_KEY=
KLING_API_BASE=

# --- MiniMax ---
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE=https://api.minimaxi.chat/v1
BRAIN_PROVIDER=minimax

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Finnhub ---
FINNHUB_API_KEY=
