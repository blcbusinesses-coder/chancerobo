# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment / secrets — NEVER commit real keys
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
*service-account*.json

# Persistent browser profiles (logins/cookies + automated-browse + interactive Chrome/Edge)
.browser-profile/
.browser-agent/
.browser-chrome/
.browser-edge/
.browser-test-*/

# Logs
logs/
*.log
npm-debug.log*

# Runtime / caches
.cache/
.tmp/
tmp/
coverage/

# Voice engine scratch audio
audio_cache/
*.mp3
*.wav

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Bundled tools (ADB / platform-tools)
.tools/

# ── chancerobo (Pi) repo excludes ──────────────────────────────
# The Electron desktop app is the COMPUTER/business Chance — not part of the Pi repo.
desktop/
# Python virtual envs (rebuilt on the Pi for ARM/Hailo)
**/.venv/
# Build artifacts / packaged bundles (regenerated by the build)
chance-pi-ui/
chance-pi-usb/
public/
*.cjs
# NOTE: frontend/dist IS committed (pre-built) so the Pi never has to build the UI.
# Downloaded ML models (fetched by setup scripts, too big for git)
vision/models/*.tflite
vision/models/*.task
vision/models/*.hef
