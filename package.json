{
  "name": "chance-ecosystem",
  "version": "0.1.0",
  "description": "The C.H.A.N.C.E Ecosystem — a multi-agent AI system orchestrated by the master agent CHANCE.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "chance": "tsx src/agents/chance/boot.ts",
    "demo": "tsx scripts/demo.ts",
    "voices": "tsx scripts/voices.ts",
    "say": "tsx scripts/say.ts",
    "browser": "tsx scripts/browser-console.ts",
    "google:auth": "tsx scripts/google-auth.ts",
    "google:whoami": "tsx scripts/google-whoami.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:test": "tsx scripts/db-test.ts",
    "tool:test": "tsx scripts/tool-test.ts",
    "server": "node --import tsx src/server.ts",
    "telegram": "node --import tsx scripts/telegram.ts",
    "pi": "node --import tsx pi/boot.ts",
    "vision": "vision/.venv/Scripts/python.exe vision/service.py",
    "vision:models": "vision/.venv/Scripts/python.exe vision/download_models.py",
    "outlets:setup": "smarthome/.venv/Scripts/python.exe smarthome/setup.py",
    "outlets:scan": "smarthome/.venv/Scripts/python.exe -m tinytuya scan",
    "voice:samples": "tsx scripts/voice-samples.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "elevenlabs": "^0.18.1",
    "express": "^5.2.1",
    "googleapis": "^174.0.1",
    "msedge-tts": "^2.0.7",
    "multer": "^2.2.0",
    "node-telegram-bot-api": "^0.66.0",
    "open": "^11.0.0",
    "playwright": "^1.47.2",
    "puppeteer": "^23.4.0",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.5",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
